INFE_PILOT_DB=/var/lib/cityu-mail-pilot/pilot.sqlite3
INFE_PILOT_MASTER_KEY=replace-with-output-of-generate-master-key
INFE_PILOT_ORIGIN=https://mail.example.com
INFE_PILOT_COOKIE_SECURE=1
INFE_PILOT_POLL_SECONDS=30
INFE_PILOT_WORKERS=3
INFE_PILOT_MAX_USERS=5
# Report generation is slow: a measured Doubao run took ~176s per email, so keep
# this comfortably above that. Raise it further if users pick slow models.
INFE_PILOT_MODEL_TIMEOUT=300
INFE_PILOT_SEARCH_TIMEOUT=45
# After importing the legacy UID set, the first poll re-scans this many hours so
# any hole the old worker left is picked up. Widen it if the migration reports
# holes older than the default 48h.
INFE_PILOT_INITIAL_LOOKBACK_HOURS=48
LOG_LEVEL=INFO

# Optional: one model credential the whole instance may fall back on, so a new
# account gets working reports before it has configured anything. Leave it unset
# and every user must bring their own key, which is the normal arrangement for a
# self-hosted install.
#
# It is a *fallback*, never an override: a user who saved their own key keeps
# using it. Whatever you put here is billed to you, and the provider records the
# calls under your account. Both of those facts are on the landing page and in
# the privacy policy, so changing this changes what those pages promise.
#
# It lives in the environment file rather than in app_settings on purpose: the
# database is copied into a daily backup, the master key deliberately is not, and
# a live API key inside a backup would undo exactly that.
#   INFE_PILOT_DEFAULT_MODEL_KEY=sk-...
#   INFE_PILOT_DEFAULT_MODEL_PROVIDER=deepseek     # defaults to deepseek
#   INFE_PILOT_DEFAULT_MODEL_NAME=deepseek-chat    # required for other providers
#   INFE_PILOT_DEFAULT_MODEL_BASE_URL=             # only for providers without a fixed host

# --- 异地备份（可选；不配就是"只在本机"）-------------------------------------
# 任何 WebDAV 空间都行（Nextcloud / Synology / 坚果云 / nginx-dav）。
# 三个变量都放这里，绝不要写在命令行或 env 前缀里。
# INFE_PILOT_BACKUP_WEBDAV_URL=https://dav.example.com/remote.php/dav/files/me/cityu-pilot
# INFE_PILOT_BACKUP_WEBDAV_USER=me@example.com
# INFE_PILOT_BACKUP_WEBDAV_PASSWORD=应用专用密码（不是登录密码）
# 保留策略可选（默认：7 天以内、最多 60 份、至少留 7 份）。
# 备份是不可压缩的密文，份数直接等于磁盘占用，所以这个窗口也是隐私政策里写明的那个数字
# —— 改了它，/privacy 与 /terms 上写的天数就与实现不一致了，两处（以及 test_compliance
# 的断言）要一起改。
# INFE_PILOT_BACKUP_KEEP_DAYS=7
